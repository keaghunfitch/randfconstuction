*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:#f4f4f4;
line-height:1.6;
}

header{
background:#222;
color:white;
padding:20px;
display:flex;
justify-content:space-between;
align-items:center;
}

header ul{
display:flex;
list-style:none;
}

header ul li{
margin-left:20px;
}

header ul li a{
color:white;
text-decoration:none;
font-weight:bold;
}

.hero{
height:500px;
background:linear-gradient(rgba(0,0,0,.5),rgba(0,0,0,.5)),
url("https://images.unsplash.com/photo-1504307651254-35680f356dfd");
background-size:cover;
background-position:center;
color:white;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
}

.hero h2{
font-size:50px;
margin-bottom:15px;
}

.hero p{
font-size:22px;
margin-bottom:25px;
}

.hero button{
padding:15px 30px;
background:#f39c12;
border:none;
font-size:18px;
cursor:pointer;
}

.hero button:hover{
background:#d68910;
}

section{
padding:60px;
}

h2{
margin-bottom:25px;
text-align:center;
}

.service-box{
background:white;
padding:20px;
margin:20px 0;
border-left:8px solid #f39c12;
box-shadow:0 0 8px rgba(0,0,0,.2);
}

form{
display:flex;
flex-direction:column;
width:60%;
margin:auto;
}

input,
textarea{
padding:15px;
margin:10px 0;
}

button{
padding:15px;
background:#222;
color:white;
border:none;
cursor:pointer;
}

button:hover{
background:#444;
}

footer{
background:#222;
color:white;
text-align:center;
padding:25px;
margin-top:30px;
}

@media(max-width:768px){

header{
flex-direction:column;
}

header ul{
flex-direction:column;
margin-top:15px;
}

header ul li{
margin:10px 0;
}

form{
width:90%;
}

.hero h2{
font-size:36px;
}

}
